{%- comment -%}
  Responsive image helper.
  Params: image (required), sizes, widths (csv), loading, fetchpriority, class, alt (override), aspect
{%- endcomment -%}
{%- liquid
  assign widths = widths | default: '300,450,600,800,1000,1200,1500,1800'
  assign sizes = sizes | default: '100vw'
  assign loading = loading | default: 'lazy'
  assign alt_text = alt | default: image.alt | escape
-%}
{%- if image != blank -%}
  {{ image | image_url: width: 1500 | image_tag:
      loading: loading,
      fetchpriority: fetchpriority,
      sizes: sizes,
      widths: widths,
      class: class,
      alt: alt_text,
      width: image.width,
      height: image.height
  }}
{%- else -%}
  {%- assign ph = placeholder | default: 'image' -%}
  <div class="placeholder-media {{ class }}">{{ ph | placeholder_svg_tag: 'placeholder-svg' }}</div>
{%- endif -%}
