[
  {
    "name": "theme_info",
    "theme_name": "Vespera",
    "theme_version": "1.1.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#faf8f1"
          },
          {
            "type": "color",
            "id": "background_alt",
            "label": "Secondary background",
            "default": "#f1ede2"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#171614"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent / links",
            "default": "#4a4f33"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button background",
            "default": "#171614"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#faf8f1"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "eb_garamond_n4"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body text size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 160,
        "step": 5,
        "unit": "px",
        "label": "Section spacing",
        "default": 110
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 0
      },
      {
        "type": "select",
        "id": "text_direction",
        "label": "Text direction",
        "default": "ltr",
        "options": [
          {
            "value": "ltr",
            "label": "Left to right"
          },
          {
            "value": "rtl",
            "label": "Right to left"
          }
        ]
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable scroll-in animations",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_badges",
        "label": "Show NEW / SALE badges",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_hover_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Enable quick add to cart",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order note",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_twitter_handle",
        "label": "X / Twitter handle (no @)"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Brand & SEO",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (used for SEO / structured data)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32x32 png)"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image"
      }
    ]
  }
]