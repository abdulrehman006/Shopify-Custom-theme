<section class="section account">
  <div class="page-width">
    <header class="account__head">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.account.logout' | t }}</a>
    </header>
    <div class="account__layout">
      <div class="account__main">
        <h2>{{ 'customer.account.orders' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <table class="account__orders">
            <thead><tr><th>{{ 'customer.orders.order' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.payment_status' | t }}</th><th>{{ 'customer.orders.fulfillment_status' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="link-underline">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      </div>
      <aside class="account__aside">
        <h2>{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.default_address.name }}<br>{{ customer.default_address.street }}<br>{{ customer.default_address.city }} {{ customer.default_address.zip }}</p>
        <a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.view_addresses' | t }}</a>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
