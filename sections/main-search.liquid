<section class="section main-search color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="section-heading">
      <h1>{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
        <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p class="main-search__count">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
        <div class="product-grid" style="--cols: 4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="card search-result--page reveal">
                <h3 class="card__title">{{ item.title }}</h3>
                <p class="card__vendor">{{ item.content | default: item.excerpt | strip_html | truncatewords: 18 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-center">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.main-search__form { display: flex; gap: 0; max-width: 520px; margin: 18px auto 0; }
.main-search__form input { border-right: 0; border-radius: 0; }
.main-search__count { text-align: center; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 32px; }
.search-result--page { padding: 20px; border: 1px solid var(--color-line); text-align: left; }
{% endstylesheet %}
{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
