{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="header" data-header role="banner">
  <div class="page-width header__grid">

    <!-- Left: nav toggle (mobile) + search -->
    <div class="header__left">
      <button class="header__icon header__burger" data-nav-toggle aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      {%- if section.settings.show_search -%}
        <button class="header__icon" data-search-toggle aria-label="{{ 'general.search.title' | t }}">
          {% render 'icon', name: 'search' %}
          <span class="header__icon-label">{{ 'general.search.placeholder' | t }}</span>
        </button>
      {%- endif -%}
    </div>

    <!-- Center: logo -->
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager', widths: '200,300,400,600' }}
      {%- elsif section.settings.use_bundled_logo -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="header__logo-bundled" loading="eager" width="1441" height="585">
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Right: account / wishlist / cart -->
    <div class="header__right">
      {%- if section.settings.show_account -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon" aria-label="Account">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      {%- if section.settings.show_wishlist -%}
        <a href="{{ routes.search_url }}?q=" class="header__icon header__icon--hide-mobile" aria-label="Wishlist">{% render 'icon', name: 'heart' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="Cart" {% if settings.cart_type == 'drawer' %}data-cart-toggle{% endif %}>
        {% render 'icon', name: 'bag' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <!-- Desktop mega nav -->
  <nav class="header__nav" aria-label="Primary">
    <ul class="header__nav-list">
      {%- for link in menu.links -%}
        <li class="header__nav-item {% if link.links != blank %}has-mega{% endif %}" data-menu-item>
          <a href="{{ link.url }}" class="header__nav-link {% if link.active or link.child_active %}is-active{% endif %}" data-menu-trigger {% if link.links != blank %}aria-haspopup="true"{% endif %}>{{ link.title }}</a>
          {%- if link.links != blank -%}
            <div class="mega">
              <div class="page-width mega__inner">
                <div class="mega__columns">
                  {%- for child in link.links -%}
                    <div class="mega__col">
                      <a href="{{ child.url }}" class="mega__col-title">{{ child.title }}</a>
                      {%- if child.links != blank -%}
                        <ul class="mega__col-links">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

<!-- Search panel -->
{%- if section.settings.show_search -%}
<div class="search-panel" data-search-panel>
  <div class="page-width search-panel__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="header__icon" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      <button type="button" class="header__icon" data-search-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-panel__results" data-predictive-results hidden></div>
  </div>
</div>
{%- endif -%}

<!-- Mobile drawer -->
<div class="nav-drawer" data-nav-drawer aria-label="Menu">
  <div class="nav-drawer__head">
    <span>{{ shop.name }}</span>
    <button class="header__icon" data-nav-toggle aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
  </div>
  <ul class="nav-drawer__list">
    {%- for link in menu.links -%}
      <li class="nav-drawer__item" data-accordion>
        {%- if link.links != blank -%}
          <button class="nav-drawer__link" data-accordion-toggle>
            <span>{{ link.title }}</span>{% render 'icon', name: 'plus' %}
          </button>
          <div class="nav-drawer__sub">
            {%- for child in link.links -%}
              <a href="{{ child.url }}" class="nav-drawer__sub-title">{{ child.title }}</a>
              {%- for grandchild in child.links -%}
                <a href="{{ grandchild.url }}" class="nav-drawer__sub-link">{{ grandchild.title }}</a>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="nav-drawer__link">{{ link.title }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  <div class="nav-drawer__foot">
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{{ 'customer.account.title' | t }}</a>
  </div>
</div>

{% stylesheet %}
.header { position: sticky; top: 0; z-index: 60; background: var(--color-bg); border-bottom: 1px solid transparent; transition: box-shadow var(--transition), border-color var(--transition); }
.header.is-scrolled { border-color: var(--color-line); box-shadow: 0 6px 24px rgba(0,0,0,0.04); }
.header__grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: var(--header-height); gap: 16px; }
.header__left { display: flex; align-items: center; gap: 18px; }
.header__right { display: flex; align-items: center; justify-content: flex-end; gap: 18px; }
.header__icon { display: inline-flex; align-items: center; gap: 8px; background: none; border: 0; color: var(--color-text); padding: 4px; }
.header__icon svg { width: 20px; height: 20px; }
.header__icon-label { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; }
.header__logo { text-align: center; justify-self: center; }
.header__logo img { max-height: 44px; width: auto; margin: 0 auto; }
.header__logo-bundled { max-height: 52px; }
.header__logo-text { font-family: var(--font-heading); font-size: 1.55rem; letter-spacing: 0.24em; text-transform: uppercase; }
.header__cart { position: relative; }
.header__cart-count { position: absolute; top: -4px; right: -8px; font-size: 0.6rem; background: var(--color-text); color: var(--color-bg); min-width: 16px; height: 16px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }
.header__burger { flex-direction: column; gap: 4px; display: none; }
.header__burger span { width: 22px; height: 1px; background: var(--color-text); display: block; }

.header__nav { border-top: 1px solid var(--color-line); }
.header__nav-list { display: flex; justify-content: center; gap: clamp(18px, 2.4vw, 40px); list-style: none; margin: 0; padding: 0; }
.header__nav-item { position: static; }
.header__nav-link { display: block; padding: 15px 0; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; position: relative; }
.header__nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 8px; height: 1px; background: var(--color-text); transform: scaleX(0); transition: transform var(--transition); }
.header__nav-item:hover .header__nav-link::after, .header__nav-link.is-active::after { transform: scaleX(1); }

.mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--color-bg); border-top: 1px solid var(--color-line); box-shadow: 0 24px 40px rgba(0,0,0,0.06); opacity: 0; visibility: hidden; transform: translateY(-8px); transition: var(--transition); z-index: 70; }
.header__nav-item.has-mega:hover .mega, .header__nav-item.is-open .mega { opacity: 1; visibility: visible; transform: none; }
.mega__inner { padding: 44px 0 52px; }
.mega__columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 36px; }
.mega__col-title { display: block; font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 16px; }
.mega__col-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
.mega__col-links a { font-size: 0.86rem; color: var(--color-text-muted); transition: color var(--transition); }
.mega__col-links a:hover { color: var(--color-text); }

.search-panel { position: fixed; top: 0; left: 0; right: 0; background: var(--color-bg); z-index: 90; transform: translateY(-100%); transition: transform var(--transition); border-bottom: 1px solid var(--color-line); }
.search-panel.is-open { transform: none; }
.search-panel__form { display: flex; align-items: center; gap: 12px; padding: 26px 0; }
.search-panel__form input { border: 0; border-bottom: 1px solid var(--color-line); border-radius: 0; font-size: 1.4rem; padding: 12px 0; background: transparent; }
.search-panel__form input:focus { border-color: var(--color-text); }

.overlay { position: fixed; inset: 0; background: rgba(20,18,14,0.4); opacity: 0; visibility: hidden; z-index: 80; transition: var(--transition); }
body.drawer-open .overlay { opacity: 1; visibility: visible; }
body.drawer-open { overflow: hidden; }

.nav-drawer { position: fixed; top: 0; left: 0; bottom: 0; width: min(88vw, 380px); background: var(--color-bg); z-index: 95; transform: translateX(-100%); transition: transform var(--transition); display: flex; flex-direction: column; }
.nav-drawer.is-active-drawer { transform: none; }
.nav-drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid var(--color-line); font-family: var(--font-heading); letter-spacing: 0.2em; text-transform: uppercase; font-size: 1rem; }
.nav-drawer__list { list-style: none; margin: 0; padding: 8px 0; overflow-y: auto; flex: 1; }
.nav-drawer__link { display: flex; align-items: center; justify-content: space-between; width: 100%; background: none; border: 0; text-align: left; padding: 15px 24px; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text); }
.nav-drawer__link svg { width: 14px; height: 14px; transition: transform var(--transition); }
.nav-drawer__item.is-open .nav-drawer__link svg { transform: rotate(45deg); }
.nav-drawer__sub { display: none; padding: 0 24px 14px; }
.nav-drawer__item.is-open .nav-drawer__sub { display: block; }
.nav-drawer__sub-title { display: block; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 14px 0 6px; }
.nav-drawer__sub-link { display: block; padding: 6px 0; color: var(--color-text-muted); font-size: 0.9rem; }
.nav-drawer__foot { padding: 20px 24px; border-top: 1px solid var(--color-line); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; }

@media (max-width: 989px) {
  .header__nav { display: none; }
  .header__burger { display: flex; }
  .header__icon-label { display: none; }
  .header__icon--hide-mobile { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (overrides bundled)" },
    { "type": "checkbox", "id": "use_bundled_logo", "label": "Use bundled Vespera logo", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": true }
  ]
}
{% endschema %}
