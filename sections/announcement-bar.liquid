<div class="announcement-bar">
  <div class="page-width announcement-bar__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.announcement-bar { background: var(--color-text); color: var(--color-bg); text-align: center; }
.announcement-bar__inner { padding: 9px 0; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping and returns on all orders" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
