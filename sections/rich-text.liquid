<div class="section rich-text color-{{ section.settings.color_scheme }}" style="text-align:{{ section.settings.alignment }}">
  <div class="page-width rich-text__inner">
    {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte rich-text__body">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link }}" class="btn" style="margin-top:24px">{{ section.settings.cta_label }}</a>{%- endif -%}
  </div>
</div>

{% stylesheet %}
.rich-text__inner { max-width: 720px; margin-inline: auto; }
.rich-text__body { font-size: 1.05rem; color: var(--color-text-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Pursuit of Quiet Luxury"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each piece is conceived as a lasting companion \u2014 crafted from the noblest fibres and finished by hand.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
