<div class="section editorial color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="editorial__grid" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="editorial__tile reveal" {{ block.shopify_attributes }}>
          <div class="editorial__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="(max-width: 749px) 100vw, 33vw" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="editorial__caption">
            {%- if block.settings.overline != blank -%}<span class="overline" style="color:#fff;opacity:.9">{{ block.settings.overline }}</span>{%- endif -%}
            <h3 class="editorial__title">{{ block.settings.heading }}</h3>
            {%- if block.settings.cta != blank -%}<span class="link-underline">{{ block.settings.cta }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.editorial__grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: clamp(12px, 1.4vw, 20px); }
.editorial__tile { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 4; }
.editorial__media { position: absolute; inset: 0; background: var(--color-bg-alt); }
.editorial__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
.editorial__tile:hover .editorial__media img { transform: scale(1.05); }
.editorial__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,18,14,0.45), transparent 55%); }
.editorial__caption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: clamp(20px, 3vw, 40px); color: #fff; text-align: center; }
.editorial__title { color: #fff; font-size: clamp(1.3rem, 2vw, 1.9rem); margin: 0 0 14px; }
@media (max-width: 989px) { .editorial__grid { --cols: 2; } }
@media (max-width: 600px) { .editorial__grid { --cols: 1; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial grid",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "overline",
          "label": "Overline"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA text",
          "default": "Discover more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
