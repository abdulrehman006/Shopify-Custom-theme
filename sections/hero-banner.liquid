{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile | default: section.settings.image
-%}
<div class="hero hero--{{ section.settings.height }} color-{{ section.settings.color_scheme }}">
  {%- if img != blank -%}
    <picture class="hero__media">
      {%- if img_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 900 }}">{%- endif -%}
      <img src="{{ img | image_url: width: 2400 }}" srcset="{{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1800 }} 1800w, {{ img | image_url: width: 2400 }} 2400w" sizes="100vw" alt="{{ img.alt | default: section.settings.heading | escape }}" loading="eager" width="{{ img.width }}" height="{{ img.height }}">
    </picture>
  {%- else -%}
    <div class="hero__media hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}</div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}<div class="hero__overlay" style="opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>{%- endif -%}

  <div class="hero__content hero__content--{{ section.settings.content_position }}" style="color:{{ section.settings.text_color }}">
    <div class="hero__inner">
      {%- if section.settings.overline != blank -%}<p class="overline" style="color:inherit;opacity:.85">{{ section.settings.overline }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="hero__buttons">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <a href="{{ block.settings.link }}" class="btn {{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.hero { position: relative; overflow: hidden; display: flex; }
.hero--small { min-height: 56vh; }
.hero--medium { min-height: 76vh; }
.hero--large { min-height: 92vh; }
.hero--full { min-height: 100vh; }
.hero__media { position: absolute; inset: 0; }
.hero__media img { width: 100%; height: 100%; object-fit: cover; }
.hero__placeholder svg { width: 100%; height: 100%; object-fit: cover; opacity: 0.3; }
.hero__overlay { position: absolute; inset: 0; background: #1a1814; }
.hero__content { position: relative; z-index: 2; width: 100%; display: flex; padding: clamp(40px, 7vw, 96px); }
.hero__content--center { justify-content: center; align-items: center; text-align: center; }
.hero__content--left { justify-content: flex-start; align-items: flex-end; }
.hero__content--right { justify-content: flex-end; align-items: flex-end; text-align: right; }
.hero__inner { max-width: 620px; }
.hero__heading { font-size: clamp(2.8rem, 7vw, 5.6rem); margin: 0 0 0.25em; line-height: 1; letter-spacing: 0.01em; }
.hero__sub { font-size: clamp(0.92rem, 1.2vw, 1.05rem); letter-spacing: 0.08em; margin-bottom: 2em; opacity: 0.9; font-weight: 300; }
.hero__buttons { display: flex; flex-wrap: wrap; gap: 14px; }
.hero__content--center .hero__buttons { justify-content: center; }
.hero__content--right .hero__buttons { justify-content: flex-end; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "large",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ]
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mediterranea"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "High Summer Capsule Collection"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "btn--light",
          "options": [
            {
              "value": "btn--light",
              "label": "Light"
            },
            {
              "value": "btn",
              "label": "Dark"
            },
            {
              "value": "btn--ghost",
              "label": "Ghost"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Women's Collection"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Men's Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
