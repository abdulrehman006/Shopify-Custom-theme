<div class="section collection-list color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="collection-list__grid" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        <a href="{{ col.url | default: block.settings.link }}" class="collection-list__tile reveal" {{ block.shopify_attributes }}>
          <div class="collection-list__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ col.title | default: 'Collection' | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- elsif col.featured_image != blank -%}
              <img src="{{ col.featured_image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy" width="{{ col.featured_image.width }}" height="{{ col.featured_image.height }}">
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="collection-list__title">{{ block.settings.title | default: col.title | default: 'Collection' }}</h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.collection-list__grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: clamp(12px, 1.4vw, 20px); }
.collection-list__tile { display: block; text-align: center; }
.collection-list__media { aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-bg-alt); }
.collection-list__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
.collection-list__tile:hover .collection-list__media img { transform: scale(1.05); }
.collection-list__title { font-size: 0.92rem; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 16px; }
@media (max-width: 749px) { .collection-list__grid { --cols: 2; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
