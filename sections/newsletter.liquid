<div class="newsletter section--tight" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  <div class="page-width newsletter__inner">
    <div class="newsletter__copy">
      {%- if section.settings.heading != blank -%}<h2 class="newsletter__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subtext != blank -%}<p class="newsletter__sub">{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      <div class="newsletter__field">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.label' | t }}" aria-label="{{ 'general.newsletter.label' | t }}" required>
        <button type="submit" class="btn">{{ 'general.newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="newsletter__success">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="newsletter__error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
.newsletter { border-top: 1px solid var(--color-line); }
.newsletter__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.newsletter__heading { font-size: clamp(1.4rem, 2.4vw, 2rem); margin: 0; }
.newsletter__sub { margin: 8px 0 0; opacity: 0.8; }
.newsletter__field { display: flex; gap: 0; max-width: 460px; margin-left: auto; }
.newsletter__field input { border-radius: 0; border-right: 0; }
.newsletter__field .btn { white-space: nowrap; }
.newsletter__success { margin-top: 10px; font-size: 0.85rem; }
.newsletter__error { margin-top: 10px; font-size: 0.85rem; color: #9c3b2e; }
@media (max-width: 749px) { .newsletter__inner { grid-template-columns: 1fr; } .newsletter__field { margin-left: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Be inspired by the latest news from the world of Vespera." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ece7dd" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#26221c" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
