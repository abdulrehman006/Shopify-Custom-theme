<div class="section image-with-text color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="iwt {% if section.settings.layout == 'right' %}iwt--reverse{% endif %}">
      <div class="iwt__media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w" sizes="(max-width: 749px) 100vw, 50vw" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="iwt__text reveal">
        {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link }}" class="btn btn--ghost" style="margin-top:14px">{{ section.settings.cta_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.iwt { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
.iwt--reverse .iwt__media { order: 2; }
.iwt__media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
.iwt__text { max-width: 480px; }
@media (max-width: 749px) { .iwt { grid-template-columns: 1fr; } .iwt--reverse .iwt__media { order: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "The House"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Hamlet of Cashmere and Harmony"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>An enduring pursuit of quiet luxury, humanistic values, and timeless craftsmanship.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Discover the philosophy"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
