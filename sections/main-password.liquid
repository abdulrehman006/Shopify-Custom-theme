<section class="section main-password text-center">
  <div class="page-width main-password__inner">
    <h1 class="header__logo-text">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<div class="rte">{{ shop.password_message }}</div>{%- endif -%}
    {%- form 'storefront_password' -%}
      <div class="field" style="max-width:360px;margin:24px auto 0">
        <input type="password" name="password" placeholder="Password" aria-label="Password">
      </div>
      <button type="submit" class="btn" style="margin-top:14px">Enter</button>
      {%- if form.errors -%}<p class="newsletter__error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% stylesheet %}
.main-password__inner { padding-block: clamp(80px, 16vw, 200px); }
{% endstylesheet %}
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
