<section class="section main-list-collections color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="section-heading">
      <h1>{{ section.settings.heading }}</h1>
    </header>
    <div class="collection-list__grid" style="--cols: {{ section.settings.columns }}">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-list__tile reveal">
          <div class="collection-list__media">
            {%- if collection.featured_image != blank -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="collection-list__title">{{ collection.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
