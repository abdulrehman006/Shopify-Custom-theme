<section class="section main-page color-{{ section.settings.color_scheme }}">
  <div class="page-width main-page__inner">
    <header class="section-heading"><h1>{{ page.title }}</h1></header>
    <div class="rte main-page__body">{{ page.content }}</div>
  </div>
</section>
{% stylesheet %}
.main-page__inner { max-width: 820px; margin-inline: auto; }
.main-page__body { font-size: 1.02rem; }
{% endstylesheet %}
{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
