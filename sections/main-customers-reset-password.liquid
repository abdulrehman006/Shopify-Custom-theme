<section class="section account">
  <div class="page-width account__narrow">
    <header class="section-heading"><h1>{{ 'customer.recover.title' | t }}</h1></header>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label>{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" required></div>
      <div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn" style="width:100%">{{ 'customer.recover.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Customer reset password", "settings": [] }
{% endschema %}
