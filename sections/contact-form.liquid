<div class="section contact color-{{ section.settings.color_scheme }}">
  <div class="page-width contact__inner">
    <div class="section-heading">
      {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>

    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'templates.contact.success' | t | default: 'Thank you. We will be in touch shortly.' }}</p>
      {%- endif -%}
      {{ form.errors | default_errors }}
      <div class="contact__row">
        <div class="field"><label for="ContactName">{{ 'templates.contact.name' | t | default: 'Name' }}</label><input type="text" id="ContactName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
        <div class="field"><label for="ContactEmail">{{ 'templates.contact.email' | t | default: 'Email' }}</label><input type="email" id="ContactEmail" name="contact[email]" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></div>
      </div>
      <div class="field"><label for="ContactPhone">{{ 'templates.contact.phone' | t | default: 'Phone' }}</label><input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}"></div>
      <div class="field"><label for="ContactMessage">{{ 'templates.contact.message' | t | default: 'Message' }}</label><textarea id="ContactMessage" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
      <button type="submit" class="btn">{{ 'templates.contact.send' | t | default: 'Send' }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
.contact__inner { max-width: 720px; margin-inline: auto; }
.contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.form-success { background: var(--color-bg-alt); padding: 14px 18px; margin-bottom: 18px; }
@media (max-width: 600px) { .contact__row { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "We would be delighted to assist you." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
