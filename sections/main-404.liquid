<section class="section main-404 color-{{ section.settings.color_scheme }}">
  <div class="page-width text-center main-404__inner">
    <p class="overline">404</p>
    <h1>{{ 'general.404.title' | t }}</h1>
    <p>{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn">{{ 'general.404.link' | t }}</a>
  </div>
</section>
{% stylesheet %}
.main-404__inner { padding-block: clamp(60px, 12vw, 160px); max-width: 520px; margin-inline: auto; }
{% endstylesheet %}
{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
